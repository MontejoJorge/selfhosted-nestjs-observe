{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm api:client && vite",
    "build": "pnpm api:client && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "pnpm api:client && tsc -b --noEmit",
    "api:client": "swagger-typescript-api generate -p ../api/openapi.json -o src/lib/api/generated -n api.ts --axios --unwrap-response-data --extract-enums --enum-style=union --extract-request-params --extract-request-body --module-name-index=1 --sort-types --sort-routes --clean-output --silent"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@selfhosted-observe/contracts": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.8.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "swagger-typescript-api": "^13.13.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
