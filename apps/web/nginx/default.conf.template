# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# ${API_UPSTREAM} is the API's host:port; ${NGINX_LOCAL_RESOLVERS} comes from /etc/resolv.conf,
# so the API's name is re-resolved when its container restarts.

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css application/javascript application/json image/svg+xml;

# Dashboard: the SPA plus the query API under /api/ (same origin, no CORS).
# No user authentication: keep this port private or put an authenticating proxy in front of it.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    set $api_upstream http://${API_UPSTREAM};
    client_max_body_size 20m;

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # The agent's ingest routes, so the OBSERVE_ENDPOINT the dashboard shows (its own origin) works too.
    location = /applications/telemetry {
        limit_except POST { deny all; }
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
    }

    location = /applications/profiles {
        limit_except POST { deny all; }
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Vite's content-hashed bundles never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback; index.html is revalidated so a new release is picked up right away.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}

# Ingest only: the two routes the @nestjs/observe agent calls, authenticated by API key.
# This is the port to expose to the services you monitor.
server {
    listen 8081;
    server_name _;

    set $api_upstream http://${API_UPSTREAM};
    client_max_body_size 20m;

    location = /applications/telemetry {
        limit_except POST { deny all; }
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_request_buffering off;
    }

    location = /applications/profiles {
        limit_except POST { deny all; }
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 404;
    }
}
