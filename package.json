{
  "name": "selfhosted-nestjs-observe",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted collector and dashboard for @nestjs/observe telemetry",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @selfhosted-observe/contracts build && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r --filter ./packages/* --filter ./apps/* build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "pnpm --filter api openapi:generate && pnpm --filter web api:client"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
