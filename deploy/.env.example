# Image tag: latest or a release version, e.g. v0.1.0.
OBSERVE_VERSION=latest

# Required. Use a long random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_USER=observe
POSTGRES_DB=observe

# [host_ip:]port for the dashboard, the API and ingest.
OBSERVE_PORT=3000

# Days of telemetry to keep.
RETENTION_DAYS=14
# Days of charts and stats to keep, at least RETENTION_DAYS.
AGGREGATE_RETENTION_DAYS=90
