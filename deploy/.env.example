# Copy to deploy/.env (read by deploy/docker-compose.yml) and adjust.

# Tag of the api and web images built by `docker compose build`.
OBSERVE_VERSION=0.0.1

# PostgreSQL. The API connects with the same credentials.
POSTGRES_USER=observe
# Required. Use a long random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
POSTGRES_DB=observe

# Published ports ([host_ip:]port). Both are served by the web container.
# Dashboard and query API: no authentication, keep it private (e.g. 127.0.0.1:8080 behind your proxy).
DASHBOARD_PORT=8080
# Ingest routes only, protected by API keys: set your services' OBSERVE_ENDPOINT to http://<host>:<port>.
INGEST_PORT=4000

# API
# Max connections in the pg pool.
DATABASE_POOL_MAX=10
# Apply pending migrations when the API boots.
DATABASE_MIGRATE_ON_START=true
# Days of telemetry to keep before partitions are dropped.
RETENTION_DAYS=14
