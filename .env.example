# PostgreSQL (docker-compose)
POSTGRES_USER=observe
POSTGRES_PASSWORD=observe
POSTGRES_DB=observe
POSTGRES_PORT=5432

# API
API_PORT=3000
# Comma-separated list of dashboard origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://observe:observe@localhost:5432/observe
# Optional. When set, ingest requests must send matching x-api-key / x-api-secret headers.
INGEST_API_KEY=
INGEST_API_SECRET=
# Days of telemetry to keep before partitions are dropped.
RETENTION_DAYS=14

# Web
VITE_API_URL=http://localhost:3000
