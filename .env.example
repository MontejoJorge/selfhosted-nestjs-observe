# PostgreSQL (docker-compose)
POSTGRES_USER=observe
POSTGRES_PASSWORD=observe
POSTGRES_DB=observe
POSTGRES_PORT=5432

# API
API_PORT=3000

# Database connection. The defaults match the docker-compose service above.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=observe
DATABASE_PASSWORD=observe
# Database name (POSTGRES_DB when using docker-compose).
DATABASE_NAME=observe
# Max connections in the pg pool.
DATABASE_POOL_MAX=10
# Apply pending migrations when the API boots.
DATABASE_MIGRATE_ON_START=true
# Days of telemetry to keep before partitions are dropped.
RETENTION_DAYS=14
# Days of per-minute rollups (charts and stats) to keep, at least RETENTION_DAYS.
AGGREGATE_RETENTION_DAYS=90

# Web
VITE_API_URL=http://localhost:3000

# Self-observation: credentials of an application in this collector, so it reports its own
# requests, jobs, errors and logs. Leave unset to disable.
# OBSERVE_APP_KEY=YOUR_APP_KEY
# OBSERVE_APP_SECRET=YOUR_APP_SECRET
# OBSERVE_ENDPOINT=http://localhost:3000

# Built dashboard served from / by the API (the Docker image sets it). Leave unset in development.
# DASHBOARD_DIR=
