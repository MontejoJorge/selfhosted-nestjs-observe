# PostgreSQL (docker-compose)
POSTGRES_USER=observe
POSTGRES_PASSWORD=observe
POSTGRES_DB=observe
POSTGRES_PORT=5432

# API
API_PORT=3000
# Comma-separated list of dashboard origins allowed by CORS.
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://observe:observe@localhost:5432/observe
# Max connections in the pg pool.
DATABASE_POOL_MAX=10
# Apply pending migrations when the API boots.
DATABASE_MIGRATE_ON_START=true
# Days of telemetry to keep before partitions are dropped.
RETENTION_DAYS=14

# Web
VITE_API_URL=http://localhost:3000
