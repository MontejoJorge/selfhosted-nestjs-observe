# PostgreSQL (docker-compose)
POSTGRES_PASSWORD=observe
POSTGRES_PORT=5432

# API
API_PORT=3000

# Database connection. The defaults match the docker-compose service above (user and database `observe`).
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=observe
DATABASE_PASSWORD=observe
DATABASE_NAME=observe
# Max connections in the pg pool.
DATABASE_POOL_MAX=10
# Apply pending migrations when the API boots.
DATABASE_MIGRATE_ON_START=true
# Days of telemetry to keep before partitions are dropped.
RETENTION_DAYS=14
# Days of per-minute rollups (charts and stats) to keep, at least RETENTION_DAYS.
AGGREGATE_RETENTION_DAYS=90
# Look up the latest release on GitHub every 6 hours. false: never (the dashboard can't turn it on).
UPDATE_CHECK=true

# Web
VITE_API_URL=http://localhost:3000

# Self-observation: the switch in Collector settings needs no credentials. Set these only to report
# with an API key of your own (they take precedence over the switch).
# OBSERVE_APP_KEY=YOUR_APP_KEY
# OBSERVE_APP_SECRET=YOUR_APP_SECRET
# OBSERVE_ENDPOINT=http://localhost:3000

# Built dashboard served from / by the API (the Docker image sets it). Leave unset in development.
# DASHBOARD_DIR=
